# Test-build env for the RanandegiYar PHP backend pilot (Iran reachability test).
# Loaded only by:  vite build --mode ranandegiyar-test  (npm run build:test-php)
# Production builds do NOT use this file, so default Firebase/guest behavior is
# unaffected. No secrets here — the PHP API base is public; the bearer token is
# issued at runtime and never embedded in code.

VITE_AUTH_PROVIDER=php
VITE_RY_API_BASE=https://nazarimaison.art/ranandegiyar-api
VITE_BASE_PATH=/ranandegiyar-test/
VITE_DISABLE_PWA=1

# Firebase vars intentionally omitted → Firebase stays dormant
# (isFirebaseConfigured=false), so all Firestore calls become harmless no-ops.
