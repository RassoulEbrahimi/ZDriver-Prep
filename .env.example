# Firebase Web App config (client-public — safe to expose, but kept in env for portability).
# Copy this file to `.env.local` and fill in the values from the Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# `.env.local` is gitignored and must NEVER be committed.
#
# Required (the app initializes Auth only when all four are present):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── PHP backend mode (opt-in; default build stays Firebase) ──
# Set provider to 'php' and point at the live API to build the cPanel artifact.
VITE_AUTH_PROVIDER=
VITE_RY_API_BASE=

# ── Manual bank-transfer subscription (S3A) ──
# All client-public. Fill REAL values ONLY in .env.local (gitignored) — never here.
# Missing values degrade gracefully (rows hidden / safe placeholder copy).
VITE_SUBSCRIPTION_PRICE_TOMAN=
VITE_PAYMENT_CARD_NUMBER=
# VITE_PAYMENT_IBAN intentionally not used for production.
VITE_PAYMENT_ACCOUNT_HOLDER=
# Telegram is the only support channel. Optional — falls back to
# https://t.me/RanandegiYarSupport when unset.
VITE_SUPPORT_TELEGRAM_URL=
