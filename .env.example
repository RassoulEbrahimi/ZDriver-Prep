# Firebase Web App config (client-public — safe to expose, but kept in env for portability).
# Copy this file to `.env.local` and fill in the values from the Firebase console
# (Project settings → General → Your apps → Web app → SDK setup and configuration).
# `.env.local` is gitignored and must NEVER be committed.
#
# Required (the app initializes Auth only when all four are present):
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional:
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
